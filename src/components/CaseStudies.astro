---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import StainComparison from './StainComparison.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.importance - a.data.importance);
---

<section class="py-12 md:py-32 bg-surface-container-low dark:bg-slate-950 transition-colors duration-300" id="projects">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-12 border-l-8 border-primary dark:border-primary-fixed pl-8 transition-colors">
      <span class="font-mono text-xs md:text-sm text-primary dark:text-primary-fixed font-bold uppercase tracking-[0.3em] mb-2 block" aria-hidden="true">TEST_REPORT_084 // CASE_STUDIES</span>
      <h2 class="font-mono font-extrabold text-3xl md:text-5xl text-on-background dark:text-slate-100 uppercase tracking-tighter">Projects</h2>
    </div>

    <!-- MOBILE VIEW: Precision Accordion (<1024px) -->
    <div class="lg:hidden space-y-4">
      {sortedProjects.map((project, index) => {
        const isOpen = index === 0;
        const triggerId = `accordion-trigger-${project.id}`;
        const contentId = `accordion-content-${project.id}`;
        return (
          <div class={`project-accordion-item border border-outline-variant dark:border-slate-800 bg-on-background dark:bg-slate-950 transition-all duration-300 overflow-hidden ${isOpen ? 'is-open' : ''}`}>
            <button 
              id={triggerId}
              class={`accordion-trigger w-full text-left p-6 flex flex-col items-start gap-2 relative group bg-on-background dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-primary ${isOpen ? 'is-open' : ''}`}
              data-project-id={project.id}
              aria-expanded={isOpen ? "true" : "false"}
              aria-controls={contentId}
            >
              <div class="font-mono text-xs text-primary-fixed dark:text-primary-fixed font-bold opacity-75">
                <span aria-hidden="true">0{index + 1} // </span>{project.data.reportId}
              </div>
              <div class="flex justify-between items-center w-full">
                <h3 class="font-mono font-bold text-lg text-white dark:text-slate-200 uppercase">{project.data.title}</h3>
                <span class="material-symbols-outlined text-white transition-transform duration-300 group-[.is-open]:rotate-180" aria-hidden="true">expand_more</span>
              </div>
            </button>
            
            <div 
              id={contentId}
              aria-labelledby={triggerId}
              class="accordion-content overflow-hidden transition-all duration-500 ease-in-out bg-on-background dark:bg-slate-950" 
              style={isOpen ? "max-height: none;" : "max-height: 0px;"}
            >
              <div class="p-6 pt-0 space-y-8 border-t border-white/10">
                <p class="font-mono text-xs md:text-sm text-slate-300 leading-relaxed mt-6">{project.data.description}</p>

                {project.data.limitations && (
                  <div class="p-3.5 bg-amber-500/10 border-l-2 border-amber-500/60">
                    <span class="block font-mono text-[11px] font-bold uppercase tracking-wider text-amber-400 mb-1">Scope & Limitations</span>
                    <p class="font-mono text-xs leading-relaxed text-slate-300">{project.data.limitations}</p>
                  </div>
                )}
                
                <div class="grid grid-cols-2 gap-px bg-primary/20 dark:bg-primary/40 border border-primary/20 dark:border-primary/40">
                  {project.data.metrics.map(metric => (
                    <div class="p-4 bg-on-background dark:bg-slate-900 transition-colors">
                      <div class="font-mono text-xl font-bold text-primary-fixed">{metric.value}</div>
                      <div class="font-mono text-[11px] uppercase font-bold text-slate-400 mt-1">{metric.label}</div>
                    </div>
                  ))}
                </div>

                <!-- Visual Probe Container -->
                <div class="space-y-2">
                  <div class="flex justify-between items-center">
                    <div class="font-mono text-[10px] text-primary-fixed bg-primary/20 px-2.5 py-1 uppercase tracking-wider border border-primary/30">
                      Visual Preview <span class="opacity-60" aria-hidden="true">[LIVE_PROBE]</span>
                    </div>
                  </div>
                  {project.id === 'stain-normalization' ? (
                    <div class="bg-black/20 p-4 transition-colors relative overflow-hidden border border-white/10">
                      <StainComparison />
                    </div>
                  ) : (
                    <div class="bg-black/20 flex items-center justify-center p-4 min-h-[250px] transition-colors relative overflow-hidden border border-white/10">
                      <Image 
                        src={project.data.imageUrl} 
                        alt={project.data.imageAlt || project.data.title} 
                        width={800} 
                        height={450} 
                        format="webp"
                        class="max-w-full max-h-[300px] object-contain opacity-90 shadow-lg" 
                      />
                    </div>
                  )}
                </div>

                <!-- Stack Trace Module (Mobile) -->
                <div class="p-4 bg-black/30 border border-white/10 space-y-3">
                  <div class="font-mono text-[10px] text-primary-fixed uppercase tracking-wider font-bold">
                    Technical Stack
                  </div>
                  <div class="grid grid-cols-1 gap-2 border-l border-white/10 pl-3">
                    <div>
                      <span class="block font-mono text-[10px] text-slate-400 uppercase font-bold">Core Engine</span>
                      <span class="font-mono text-xs text-slate-300">{project.data.techStack?.engine?.join(', ') || 'N/A'}</span>
                    </div>
                    <div>
                      <span class="block font-mono text-[10px] text-slate-400 uppercase font-bold">Engineering</span>
                      <span class="font-mono text-xs text-slate-300">{project.data.techStack?.engineering?.join(', ') || 'N/A'}</span>
                    </div>
                    <div>
                      <span class="block font-mono text-[10px] text-slate-400 uppercase font-bold">Delivery</span>
                      <span class="font-mono text-xs text-slate-300">{project.data.techStack?.delivery?.join(', ') || 'N/A'}</span>
                    </div>
                  </div>
                </div>

                <!-- Log Output -->
                <div class="bg-black/40 p-4 border border-white/5 overflow-hidden transition-colors">
                  <div class="flex justify-between mb-3 border-b border-white/10 pb-2">
                    <span class="font-mono text-[11px] text-slate-400 uppercase font-bold">Code Excerpt: {project.data.codeSnippet.filename}</span>
                  </div>
                  <pre class="font-mono text-xs text-blue-300 overflow-x-auto whitespace-pre custom-scrollbar leading-relaxed"><code>{project.data.codeSnippet.code}</code></pre>
                </div>

                <div class="pt-4 border-t border-outline-variant/30 dark:border-slate-800/30 flex justify-end gap-3">
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="bg-primary px-4 py-2.5 font-mono text-xs font-bold text-white uppercase tracking-wider hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-primary transition-colors shadow-lg flex items-center gap-2">
                       <span>Launch App</span>
                       <span class="material-symbols-outlined text-sm" aria-hidden="true">rocket_launch</span>
                       <span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                  <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="bg-secondary px-4 py-2.5 font-mono text-xs font-bold text-white uppercase tracking-wider hover:bg-secondary-container focus:outline-none focus:ring-2 focus:ring-secondary transition-colors shadow-lg flex items-center gap-2">
                     <span>View Source</span>
                     <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                     <span class="sr-only"> (opens in new tab)</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- DESKTOP VIEW: Laboratory Console (>=1024px) -->
    <div class="hidden lg:grid grid-cols-12 gap-0 border border-outline-variant dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl transition-colors">
      
      <!-- Sidebar Navigation -->
      <div class="col-span-4 border-r border-outline-variant dark:border-slate-800 flex flex-col transition-colors sticky top-20 self-start max-h-[calc(100vh-5rem)]">
        <div class="p-6 border-b border-outline-variant dark:border-slate-800 bg-surface dark:bg-slate-950 flex items-center justify-between">
          <span class="font-mono text-xs font-bold text-on-surface dark:text-slate-300 uppercase tracking-wider">
            Selected Projects <span class="text-slate-500 font-normal" aria-hidden="true">({sortedProjects.length})</span>
          </span>
          <div class="flex space-x-1" aria-hidden="true">
            <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
            <div class="w-2 h-2 rounded-full bg-primary/20"></div>
          </div>
        </div>
        
        <div 
          class="flex-1 overflow-y-auto custom-scrollbar"
          role="tablist"
          aria-label="Project Case Studies"
        >
          {sortedProjects.map((project, index) => {
            const isSelected = index === 0;
            return (
              <button 
                id={`tab-${project.id}`}
                role="tab"
                aria-selected={isSelected ? "true" : "false"}
                aria-controls={`content-${project.id}`}
                tabindex={isSelected ? 0 : -1}
                class={`project-nav-btn w-full text-left p-6 xl:p-8 border-b border-outline-variant dark:border-slate-800 transition-all duration-300 hover:bg-surface-container-high dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary focus:z-10 group relative ${isSelected ? 'is-active bg-surface-container-low dark:bg-slate-900' : ''}`}
                data-project-id={project.id}
              >
                <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary scale-y-0 transition-transform duration-300 origin-top group-[.is-active]:scale-y-100"></div>
                <div class="font-mono text-xs text-primary dark:text-primary-fixed font-bold mb-2 opacity-75 group-[.is-active]:opacity-100">
                  <span aria-hidden="true">0{index + 1} // </span>{project.data.reportId}
                </div>
                <h3 class="font-mono font-bold text-xl text-on-background dark:text-slate-200 uppercase leading-tight group-[.is-active]:text-primary dark:group-[.is-active]:text-primary-fixed transition-colors">
                  {project.data.title}
                </h3>
                <div class="mt-4 flex flex-wrap gap-2 text-slate-600 dark:text-slate-400 group-[.is-active]:text-slate-800 dark:group-[.is-active]:text-slate-200 transition-colors">
                  {project.data.tags.slice(0, 3).map(tag => (
                    <span class="font-mono text-[11px] font-semibold border border-outline-variant dark:border-slate-700 px-2 py-0.5 uppercase bg-surface dark:bg-slate-800/60">{tag}</span>
                  ))}
                </div>
              </button>
            );
          })}
        </div>

        <!-- Sidebar Footer Note to prevent empty space -->
        <div class="p-6 border-t border-outline-variant dark:border-slate-800 bg-surface-container-low dark:bg-slate-950 text-slate-600 dark:text-slate-400 space-y-3">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-primary dark:text-primary-fixed">
            Pipeline Architectures
          </div>
          <p class="font-mono text-xs leading-relaxed">
            Each case study focuses on high-integrity image pipelines—from spectral signal normalization to low-latency edge deployment.
          </p>
          <a href="#contact" class="inline-flex items-center gap-1 font-mono text-xs font-bold text-primary dark:text-primary-fixed hover:underline">
            Discuss a project <span class="material-symbols-outlined text-[14px]" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Detail Display Panel -->
      <div class="col-span-8 relative bg-on-background dark:bg-slate-950 transition-colors flex flex-col min-h-0">
        <div class="absolute inset-0 opacity-5 technical-grid pointer-events-none" aria-hidden="true"></div>
        
        {sortedProjects.map((project, index) => {
          const isSelected = index === 0;
          return (
            <div 
              id={`content-${project.id}`} 
              role="tabpanel"
              aria-labelledby={`tab-${project.id}`}
              tabindex="0"
              aria-hidden={isSelected ? "false" : "true"}
              class={`project-content-pane flex flex-col transition-all duration-300 focus:outline-none ${isSelected ? 'relative opacity-100 z-10' : 'hidden opacity-0 z-0 pointer-events-none'}`}
            >
              <!-- Details Header -->
              <div class="p-8 xl:p-10 pb-6 space-y-6">
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <span class="font-mono text-xs bg-white/10 text-white/90 px-3 py-1 uppercase border border-white/10">{tag}</span>
                  ))}
                </div>
                <p class="font-mono text-sm md:text-base text-slate-300 leading-relaxed max-w-2xl">
                  {project.data.description}
                </p>

                {project.data.limitations && (
                  <div class="p-4 bg-amber-500/10 border-l-2 border-amber-500/60 max-w-2xl">
                    <span class="block font-mono text-xs font-bold uppercase tracking-wider text-amber-400 mb-1">Scope & Limitations</span>
                    <p class="font-mono text-xs leading-relaxed text-slate-300">{project.data.limitations}</p>
                  </div>
                )}

                <!-- Stack Trace Module -->
                <div class="pt-2 space-y-3">
                  <div class="font-mono text-xs text-primary-fixed bg-primary/20 px-2.5 py-1 inline-block uppercase tracking-wider border border-primary/30 font-bold">
                    Technical Stack <span class="opacity-60 text-[10px] font-normal" aria-hidden="true">[STACK_TRACE]</span>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-l border-white/10 pl-6 py-2">
                    <div class="space-y-1">
                      <div class="font-mono text-[11px] text-slate-400 uppercase font-bold tracking-wider">Core Engine</div>
                      <div class="font-mono text-xs text-slate-200">{project.data.techStack?.engine?.join(', ') || 'N/A'}</div>
                    </div>
                    <div class="space-y-1">
                      <div class="font-mono text-[11px] text-slate-400 uppercase font-bold tracking-wider">Engineering</div>
                      <div class="font-mono text-xs text-slate-200">{project.data.techStack?.engineering?.join(', ') || 'N/A'}</div>
                    </div>
                    <div class="space-y-1">
                      <div class="font-mono text-[11px] text-slate-400 uppercase font-bold tracking-wider">Delivery</div>
                      <div class="font-mono text-xs text-slate-200">{project.data.techStack?.delivery?.join(', ') || 'N/A'}</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Metrics Bar -->
              <div class="grid grid-cols-2 bg-on-background dark:bg-slate-950 border-y border-white/10">
                {project.data.metrics.map((metric, idx) => (
                  <div class={`px-8 xl:px-10 py-6 hover:bg-slate-900 transition-colors group ${idx % 2 === 0 ? 'border-r border-white/5' : ''}`}>
                    <div class="font-mono text-2xl xl:text-3xl font-bold text-primary-fixed leading-none group-hover:scale-105 transition-transform origin-left">{metric.value}</div>
                    <div class="font-mono text-xs uppercase font-bold text-slate-400 tracking-wider mt-2">{metric.label}</div>
                  </div>
                ))}
              </div>

              <!-- Data Probe Area -->
              <div class="flex-none flex flex-col bg-on-background dark:bg-slate-950">
                <!-- Visual Probe -->
                <div class="relative bg-black/20 flex flex-col p-8 xl:p-10 border-b border-white/5 min-h-[460px] overflow-hidden">
                  <!-- Internal Header -->
                  <div class="flex justify-between items-center mb-6">
                    <div class="font-mono text-[10px] text-primary-fixed bg-primary/20 px-3 py-1 uppercase tracking-wider border border-primary/30 font-bold">
                      Visual Preview <span class="opacity-60" aria-hidden="true">[LIVE_PROBE]</span>
                    </div>
                  </div>
                  
                  {project.id === 'stain-normalization' ? (
                    <div class="flex-1 w-full">
                      <StainComparison />
                    </div>
                  ) : (
                    <div class="flex-1 flex items-center justify-center min-h-0 w-full relative group">
                      <Image 
                        src={project.data.imageUrl} 
                        alt={project.data.imageAlt || project.data.title} 
                        width={1920}
                        height={1080}
                        format="webp"
                        class="w-full h-full object-contain transition-all duration-700 opacity-90 hover:opacity-100"
                      />
                      <div class="absolute inset-0 border border-white/10 pointer-events-none" aria-hidden="true"></div>
                    </div>
                  )}

                  <!-- Action Bar -->
                  <div class="w-full flex justify-end pt-6 gap-4">
                     {project.data.liveUrl && (
                      <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="bg-primary px-6 py-3 font-mono text-xs font-bold text-white uppercase tracking-wider hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-primary transition-colors shadow-lg flex items-center gap-2">
                         <span>Launch App</span>
                         <span class="material-symbols-outlined text-sm" aria-hidden="true">rocket_launch</span>
                         <span class="sr-only"> (opens in new tab)</span>
                      </a>
                    )}
                     <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="bg-secondary px-6 py-3 font-mono text-xs font-bold text-white uppercase tracking-wider hover:bg-secondary-container focus:outline-none focus:ring-2 focus:ring-secondary transition-colors shadow-lg flex items-center gap-2">
                        <span>View Source</span>
                        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                        <span class="sr-only"> (opens in new tab)</span>
                     </a>
                  </div>
                </div>

                <!-- Log Output (Expanded) -->
                <div class="p-8 xl:p-10 bg-black/40 flex flex-col border-t border-white/5">
                  <div class="flex justify-between items-center mb-3 border-b border-white/10 pb-2">
                    <span class="font-mono text-xs text-slate-400 uppercase font-bold tracking-wider flex items-center">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2" aria-hidden="true"></span>
                      Code Excerpt: {project.data.codeSnippet.filename}
                    </span>
                  </div>
                  <pre class="font-mono text-xs text-blue-300 leading-relaxed whitespace-pre overflow-x-auto custom-scrollbar"><code>{project.data.codeSnippet.code}</code></pre>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function initProjectConsole() {
    const root = document.getElementById('projects');
    if (!root || root.hasAttribute('data-console-initialized')) return;
    root.setAttribute('data-console-initialized', 'true');

    const navButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.project-nav-btn'));
    const contentPanes = Array.from(root.querySelectorAll<HTMLElement>('.project-content-pane'));

    const selectTab = (btn: HTMLButtonElement) => {
      const projectId = btn.dataset.projectId;

      navButtons.forEach(b => {
        b.classList.remove('is-active', 'bg-surface-container-low', 'dark:bg-slate-900');
        b.setAttribute('aria-selected', 'false');
        b.tabIndex = -1;
      });
      btn.classList.add('is-active', 'bg-surface-container-low', 'dark:bg-slate-900');
      btn.setAttribute('aria-selected', 'true');
      btn.tabIndex = 0;
      btn.focus();

      contentPanes.forEach(pane => {
        if (pane.id === `content-${projectId}`) {
          pane.classList.remove('hidden', 'opacity-0', 'z-0', 'pointer-events-none');
          pane.classList.add('relative', 'opacity-100', 'z-10');
          pane.setAttribute('aria-hidden', 'false');
        } else {
          pane.classList.add('hidden', 'opacity-0', 'z-0', 'pointer-events-none');
          pane.classList.remove('relative', 'opacity-100', 'z-10');
          pane.setAttribute('aria-hidden', 'true');
        }
      });
    };

    navButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => selectTab(btn));

      btn.addEventListener('keydown', (e) => {
        let nextIndex = idx;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          nextIndex = (idx + 1) % navButtons.length;
          selectTab(navButtons[nextIndex]);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          nextIndex = (idx - 1 + navButtons.length) % navButtons.length;
          selectTab(navButtons[nextIndex]);
        } else if (e.key === 'Home') {
          e.preventDefault();
          selectTab(navButtons[0]);
        } else if (e.key === 'End') {
          e.preventDefault();
          selectTab(navButtons[navButtons.length - 1]);
        }
      });
    });

    // Mobile Accordion Logic
    const accordionTriggers = root.querySelectorAll<HTMLButtonElement>('.accordion-trigger');
    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.project-accordion-item');
        const content = item?.querySelector('.accordion-content') as HTMLElement;
        const isOpen = trigger.classList.contains('is-open');

        root.querySelectorAll('.project-accordion-item').forEach(otherItem => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector('.accordion-trigger');
            const otherContent = otherItem.querySelector('.accordion-content') as HTMLElement;
            if (otherTrigger) {
              otherTrigger.classList.remove('is-open');
              otherTrigger.setAttribute('aria-expanded', 'false');
            }
            if (otherContent) otherContent.style.maxHeight = '0px';
          }
        });

        if (isOpen) {
          trigger.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0px';
        } else {
          trigger.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });
  }

  initProjectConsole();
  document.addEventListener('astro:after-swap', () => {
    const root = document.getElementById('projects');
    if (root) root.removeAttribute('data-console-initialized');
    initProjectConsole();
  });
</script>

<style>
  .technical-grid {
    background-image: 
      linear-gradient(to right, rgba(0, 99, 153, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 99, 153, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    transition: transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
