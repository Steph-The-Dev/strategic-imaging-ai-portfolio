---
import { Image } from 'astro:assets';
import heroGeometry from '../assets/hero_geometry.png';
---

<section class="relative border-b border-outline-variant dark:border-slate-800 bg-white dark:bg-slate-900 technical-grid transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-20 lg:py-32 grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch">
    <div class="lg:col-span-7 space-y-10 border-r-0 lg:border-r border-outline-variant dark:border-slate-800 pr-0 lg:pr-12">
      <div class="flex flex-wrap gap-3 items-center">
        {/* TODO(owner): Confirm exact hero status wording (e.g. "Available for projects" vs "Active & Available") */}
        <div class="inline-flex items-center h-8 gap-2.5 border border-outline-variant dark:border-primary/30 px-3 bg-surface-container dark:bg-primary/10 transition-colors">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0" aria-hidden="true"></span>
          <span class="font-mono text-xs font-bold text-primary dark:text-primary-fixed uppercase tracking-wider leading-none">Available for projects</span>
        </div>
        <div class="inline-flex items-center h-8 gap-2 border border-outline-variant dark:border-slate-700 px-3 bg-surface dark:bg-slate-800 transition-colors">
          <span class="material-symbols-outlined text-[16px] leading-none text-primary flex-shrink-0 flex items-center justify-center w-4 h-4" aria-hidden="true">location_on</span>
          <span class="font-mono text-xs font-bold text-on-surface dark:text-slate-300 uppercase tracking-wider leading-none">Basel, CH / Remote</span>
        </div>
      </div>
      <h1 class="font-mono font-extrabold text-4xl md:text-6xl leading-[0.95] tracking-tighter text-on-background dark:text-slate-100 uppercase transition-colors">
        Bridging <span class="bg-primary text-white px-2 inline-block box-decoration-clone">Visual Expertise</span><br/>with Data Science.
      </h1>
      <div class="font-mono text-sm md:text-base space-y-4 max-w-xl text-on-surface-variant dark:text-slate-400 border-l-4 border-primary pl-6 transition-colors">
        <p class="leading-relaxed">
          Combining 20 years of digital signal processing and color science with modern machine learning. I build computer vision pipelines for complex image data - from digital pathology to satellite imagery.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-0 pt-4">
        <a class="inline-flex justify-center items-center px-6 py-4 bg-on-background dark:bg-slate-100 text-white dark:text-slate-900 font-mono text-xs font-bold uppercase tracking-widest hover:bg-primary dark:hover:bg-primary-fixed focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors border-r border-white/10 dark:border-slate-900/10" href="#projects">
          VIEW PROJECTS
        </a>
        <a class="inline-flex justify-center items-center px-6 py-4 border border-on-background dark:border-slate-500 text-on-background dark:text-slate-300 font-mono text-xs font-bold uppercase tracking-widest hover:bg-surface-container-high dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors" href="#contact">
          GET IN TOUCH
        </a>
      </div>
    </div>
    <div class="lg:col-span-5 relative hidden lg:flex flex-col justify-center items-center p-12">
      {/* TODO(owner): Optional swap of staircase photo for an actual project asset (histology tile or satellite crop) */}
      <div class="w-full aspect-square border-2 border-on-surface dark:border-slate-700 p-4 relative group transition-colors">
        <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-primary -translate-x-1 -translate-y-1"></div>
        <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-primary translate-x-1 -translate-y-1"></div>
        <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-primary -translate-x-1 translate-y-1"></div>
        <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-primary translate-x-1 translate-y-1"></div>
        <Image 
          src={heroGeometry} 
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute top-1/2 left-0 w-full h-[1px] bg-primary/20 pointer-events-none"></div>
        <div class="absolute top-0 left-1/2 h-full w-[1px] bg-primary/20 pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>
