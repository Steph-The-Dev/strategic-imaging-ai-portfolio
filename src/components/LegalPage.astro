---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} | Stephan Pfeiffer`} description={title} lang="de" noindex>
  <header class="w-full bg-white dark:bg-slate-900 border-b-2 border-on-surface dark:border-slate-700 transition-colors duration-300">
    <div class="flex items-center max-w-4xl mx-auto px-6 h-14">
      <a href="/" class="font-mono font-bold text-sm tracking-tight text-on-background dark:text-slate-100 hover:bg-primary hover:text-white px-2 py-4 transition-all -ml-2">
        ← Stephan Pfeiffer
      </a>
    </div>
  </header>

  <main id="main-content" class="min-h-[75vh] py-12 md:py-20 bg-white dark:bg-slate-900 transition-colors duration-300 focus:outline-none" tabindex="-1">
    <article class="legal max-w-4xl mx-auto px-6 font-mono text-sm leading-relaxed text-on-surface-variant dark:text-slate-300 space-y-6">
      <h1 class="font-mono font-extrabold text-3xl md:text-5xl text-on-background dark:text-slate-100 uppercase tracking-tighter">{title}</h1>
      <slot />
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .legal :global(h2) {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 1rem;
  }
  .legal :global(.placeholder) {
    border-left: 4px solid currentColor;
    padding-left: 1rem;
    opacity: 0.7;
    font-style: italic;
  }
</style>
