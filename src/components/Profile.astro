---
import { Image } from 'astro:assets';
import operatorProfile from '../assets/operator_profile.jpg';
---

<section class="py-12 md:py-24 bg-surface-container-low dark:bg-slate-950 border-b border-outline-variant dark:border-slate-800 transition-colors duration-300" id="profile">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- Title Column -->
    <div class="lg:col-span-4 relative pt-12 lg:pt-16">
      <!-- Absolute-positioned label sits above the grid alignment point -->
      <div class="absolute top-0 left-0 inline-flex items-center space-x-2 bg-primary/10 px-3 py-1 border border-primary/20">
        <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
        <span class="font-mono text-[10px] font-bold text-primary dark:text-primary-fixed uppercase tracking-widest">Operator_Profile</span>
      </div>

      <!-- Profile Image Module -->
      <div 
        class="profile-module relative group max-w-[280px] cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-slate-950"
        role="button"
        tabindex="0"
        aria-pressed="false"
        aria-label="Toggle portrait color filter"
      >
        <div class="hover-border absolute -inset-2 border border-primary/20 scale-95 opacity-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-500 pointer-events-none"></div>
        <div class="aspect-square bg-slate-200 dark:bg-slate-800 overflow-hidden border-2 border-on-background dark:border-slate-700 relative">
          <Image 
            src={operatorProfile} 
            alt="Portrait of Stephan Pfeiffer" 
            widths={[280, 560]}
            sizes="(max-width: 280px) 100vw, 280px"
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
          />
          <!-- Scanline Overlay Effect - Now Fades Out on Hover -->
          <div class="scanline-overlay absolute inset-0 pointer-events-none opacity-40 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_3px,4px_100%] group-hover:opacity-0 transition-opacity duration-500"></div>
        </div>
        <div class="absolute bottom-2 right-2 bg-primary text-white font-mono text-[10px] px-2 py-0.5 uppercase tracking-tighter">
          ID_CONFIRMED
        </div>
      </div>

      <div class="space-y-6 pt-10">
        <h2 class="font-mono font-extrabold text-3xl md:text-5xl text-on-background dark:text-slate-100 uppercase tracking-tighter leading-[0.9]">
          Profile
        </h2>
        <p class="font-mono text-xs md:text-sm text-on-surface-variant dark:text-slate-400 leading-relaxed">
          Bridging visual domain knowledge, data integrity, and machine learning pipelines.
        </p>
      </div>
    </div>

    <!-- Content Column -->
    <div class="lg:col-span-8 space-y-12 pt-12 lg:pt-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Strategic Interface -->
        <div class="space-y-4">
          <h3 class="font-mono font-bold text-sm text-primary dark:text-primary-fixed uppercase tracking-wider underline decoration-2 underline-offset-4 transition-colors">Business_&_Tech_Bridge</h3>
          <div class="font-mono text-sm text-on-surface-variant dark:text-slate-400 border-l-4 border-primary pl-6 py-1 transition-colors">
            <p class="leading-relaxed">
              I act as the bridge between technical execution and business goals. With a background in International Business (Dipl.-Kaufmann), I ensure that machine learning pipelines solve real-world problems in high-stakes fields like Life Sciences and ESG.
            </p>
          </div>
        </div>
        <!-- Data Integrity -->
        <div class="space-y-4">
          <h3 class="font-mono font-bold text-sm text-primary dark:text-primary-fixed uppercase tracking-wider underline decoration-2 underline-offset-4 transition-colors">Data_Integrity</h3>
          <div class="font-mono text-sm text-on-surface-variant dark:text-slate-400 border-l-4 border-primary pl-6 py-1 transition-colors">
            <p class="leading-relaxed">
              A model is only as good as its data. My experience with complex visual pipelines ensures that every system I build is founded on robust validation, quality assurance, and clean signal processing.
            </p>
          </div>
        </div>
      </div>

      <!-- Visual Systems Architect Manifest -->
      <div class="bg-surface-container dark:bg-slate-900 p-8 border-l-8 border-primary dark:border-secondary-container relative overflow-hidden transition-colors">
        <div class="absolute top-0 right-0 p-2 opacity-5 dark:opacity-10 pointer-events-none">
          <span class="material-symbols-outlined text-6xl text-on-surface dark:text-white transition-colors" aria-hidden="true">terminal</span>
        </div>
        <div class="font-mono text-[10px] text-primary dark:text-secondary-container font-bold mb-4 uppercase tracking-[0.2em] transition-colors">[TECHNICAL_STACK_MANIFEST]</div>
        <p class="font-mono text-xs md:text-sm text-on-surface dark:text-slate-200 leading-relaxed relative z-10 transition-colors">
          My technical architecture bridges classical imaging physics with modern deep learning. I specialize in <span class="text-primary dark:text-white font-bold">high-integrity Python pipelines</span> for complex visual data (GeoTIFFs, Digital Pathology).
        </p>
        
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 relative z-10">
          <div class="space-y-3">
            <span class="block font-mono text-[9px] text-slate-500 dark:text-slate-400 uppercase font-bold tracking-tighter">Core_Engines</span>
            <div class="flex flex-wrap gap-2">
              {["PyTorch", "OpenCV", "NumPy", "Rasterio", "Matplotlib", "Seaborn"].map(tech => (
                <span class="font-mono text-[10px] font-bold px-2.5 py-1 bg-secondary/10 dark:bg-secondary/20 border border-secondary/30 dark:border-secondary/40 text-secondary-container dark:text-secondary-fixed-dim hover:bg-secondary hover:text-white transition-colors cursor-default uppercase">{tech}</span>
              ))}
            </div>
          </div>
          <div class="space-y-3">
            <span class="block font-mono text-[9px] text-slate-500 dark:text-slate-400 uppercase font-bold tracking-tighter">Architecture_&_Ops</span>
            <div class="flex flex-wrap gap-2">
              {["Pydantic V2", "Mypy (Strict)", "GitHub Actions", "Streamlit"].map(tech => (
                <span class="font-mono text-[10px] font-bold px-2.5 py-1 bg-secondary/10 dark:bg-secondary/20 border border-secondary/30 dark:border-secondary/40 text-secondary-container dark:text-secondary-fixed-dim hover:bg-secondary hover:text-white transition-colors cursor-default uppercase">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Tech Stack / Metadata Strip -->
      <div class="bg-white dark:bg-slate-900 border border-outline-variant dark:border-slate-800 p-6 space-y-6 transition-colors">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div>
            <span class="block font-mono text-[10px] text-slate-500 uppercase font-bold mb-1">Human_Languages</span>
            <span class="font-mono text-xs text-on-background dark:text-slate-200">DE (Native), EN (Fluent), ES, PT</span>
          </div>
          <div>
            <span class="block font-mono text-[10px] text-slate-500 uppercase font-bold mb-1">Domain_Focus</span>
            {/* TODO(owner): Add evidence for Pharma or retain Digital Pathology / ESG / Media */}
            <span class="font-mono text-xs text-on-background dark:text-slate-200">Digital Pathology, ESG, Media</span>
          </div>
          <div>
            <span class="block font-mono text-[10px] text-slate-500 uppercase font-bold mb-1">Core_Signal</span>
            {/* TODO(owner): Confirm Core_Signal tags; GANs and XAI removed pending project evidence */}
            <span class="font-mono text-xs text-on-background dark:text-slate-200">CIELAB/HSV, Classical CV, Deep Learning</span>
          </div>
          <div>
            <span class="block font-mono text-[10px] text-slate-500 uppercase font-bold mb-1">Availability</span>
            {/* TODO(owner): Confirm exact availability status wording */}
            <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-bold uppercase">Open to projects</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initProfileInteractivity() {
    const profileModule = document.querySelector('.profile-module');
    if (profileModule && !profileModule.hasAttribute('data-initialized')) {
      profileModule.setAttribute('data-initialized', 'true');
      const toggleActive = () => {
        const isActive = profileModule.classList.toggle('is-active');
        profileModule.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      };
      profileModule.addEventListener('click', toggleActive);
      profileModule.addEventListener('keydown', (e) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          toggleActive();
        }
      });
    }
  }

  // Initialize on page load
  initProfileInteractivity();
  // Re-initialize after Astro view transitions
  document.addEventListener('astro:after-swap', initProfileInteractivity);
</script>

<style>
  /* Mobile-specific active state for scanline/grayscale toggle */
  @media (max-width: 1023px) {
    .profile-module.is-active .scanline-overlay {
      opacity: 0 !important;
    }
    .profile-module.is-active img {
      filter: grayscale(0) !important;
    }
    .profile-module.is-active .hover-border {
      opacity: 100 !important;
      transform: scale(1) !important;
    }
  }
</style>
