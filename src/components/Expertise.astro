---
import CareerPhase from "./CareerPhase.astro";
import type { Props as CareerPhaseProps } from "./CareerPhase.astro";

const careerPhases: CareerPhaseProps[] = [
  {
    id: "MOD_01",
    status: "FOUNDATION_LOCKED",
    statusColor: "green",
    title: "Dipl.-Kaufmann (Int. Business)",
    description:
      "Structural business logic and international marketing management foundations.",
    metadata: ["Strategic_Mgmt", "Linguistic_S1", "Marketing_Quant"],
  },
  {
    id: "MOD_02",
    status: "CORE_EXPERTISE",
    statusColor: "secondary",
    title: "TV Editor & Colorist (20Y)",
    description:
      "Deep specialization in visual storytelling and high-precision digital image processing.",
    metadata: ["Chromatic_Eng", "NLE_Architecture", "Signal_QC"],
  },
  {
    id: "MOD_03",
    status: "EXECUTED_06.26",
    statusColor: "amber",
    title: "Deep Learning Specialization",
    description:
      "GSERM, Univ. St. Gallen. Advanced neural network architectures under Prof. Damian Borth.",
    metadata: ["CNNs", "Vision_Transformers", "Pytorch"],
  },
  {
    id: "MOD_04",
    status: "ACTIVE_09.26",
    statusColor: "purple",
    title: "MSc Applied Data Science @ Artificial Intelligence",
    description:
      "HSLU. Converting 20 years of visual domain expertise into scalable Computer Vision and AI architectures.",
    metadata: ["Computer_Vision", "Edge_AI", "Trustworthy_AI"],
  },
];
---

<section
  class="py-12 md:py-24 bg-white dark:bg-slate-900 border-b border-outline-variant dark:border-slate-700 transition-colors duration-300"
  id="experience"
>
  <div class="max-w-7xl mx-auto px-6">
    <div
      class="mb-12 border-l-8 border-primary dark:border-primary-fixed pl-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4 transition-colors"
    >
      <div>
        <span
          class="font-mono text-xs md:text-sm text-primary dark:text-primary-fixed font-bold uppercase tracking-[0.3em] mb-2 block"
          aria-hidden="true"
          >PHASE_MAPPING // CAREER_ARCHITECTURE</span
        >
        <h2
          class="font-mono font-extrabold text-3xl md:text-5xl text-on-background dark:text-slate-100 uppercase tracking-tighter"
        >
          Experience
        </h2>
      </div>
      <div
        class="font-mono text-[11px] md:text-xs text-on-surface-variant dark:text-slate-400 uppercase text-left md:text-right leading-tight transition-colors"
      >
        Doc. Type: Career_Architecture_v2.4<br />
        Last Sync: 2026-Q4
      </div>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px bg-outline-variant dark:bg-slate-700 border border-outline-variant dark:border-slate-700 transition-colors xl:grid-rows-[auto_auto_1fr_auto]"
    >
      {careerPhases.map((phase) => <CareerPhase {...phase} />)}
    </div>

    <div
      class="mt-12 bg-surface-container dark:bg-slate-800 p-8 md:p-10 border border-outline-variant dark:border-slate-700 flex flex-col md:flex-row gap-10 items-center transition-colors"
    >
      <div class="flex-shrink-0">
        <span
          class="material-symbols-outlined text-5xl text-primary dark:text-primary-fixed"
          >hub</span
        >
      </div>
      <div
        class="font-mono text-sm md:text-base text-on-surface-variant dark:text-slate-300 flex-grow leading-relaxed"
      >
        <strong
          class="text-on-surface dark:text-slate-100 uppercase tracking-wider"
          >Background & Focus:</strong
        > My trajectory combines business foundations (Dipl.-Kaufmann), 20 years of digital imaging
        and signal processing, and applied machine learning (MSc HSLU). This foundation enables robust
        computer vision pipelines tailored to real-world industrial and clinical constraints.
      </div>
    </div>
  </div>
</section>
