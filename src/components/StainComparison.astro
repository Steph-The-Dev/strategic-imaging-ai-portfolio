</section>

<style>
  /* ────────────────────────────────────────────────────────────
     STAIN COMPARISON — Root Container
     ──────────────────────────────────────────────────────────── */
  .stain-comparison {
    padding: 0;
  }

  /* ────────────────────────────────────────────────────────────
     SECTION HEADER (shared)
     ──────────────────────────────────────────────────────────── */
  .section-header {
    margin-bottom: 1.5rem;
  }

  .header-title {
    font-family: monospace;
    font-weight: 800;
    font-size: 1.25rem;
    color: #e2e8f0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }

  .header-subtitle {
    font-family: monospace;
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
  }

  /* ────────────────────────────────────────────────────────────
     SLIDER SECTION
     ──────────────────────────────────────────────────────────── */
  .slider-section {
    margin-bottom: 3rem;
  }

  .slider-container {
    max-width: 800px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .slider-figure {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .slider-figure img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
  }

  .slider-label {
    position: absolute;
    bottom: 12px;
    height: 28px;
    box-sizing: border-box;
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
    z-index: 5;
  }

  .slider-label--left {
    left: 12px;
  }

  .slider-label--right {
    right: 12px;
  }

  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .label-dot--red {
    background: #ef4444;
    box-shadow: 0 0 6px #ef4444;
  }

  .label-dot--green {
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  /* Style the slider divider line */
  img-comparison-slider {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    --divider-width: 2px;
    --divider-color: rgba(168, 199, 250, 0.6);
    --default-handle-opacity: 0.9;
    --default-handle-width: 40px;
  }

  /* ────────────────────────────────────────────────────────────
     GRID SECTION — Domain Adaptation
     ──────────────────────────────────────────────────────────── */
  .grid-section {
    margin-top: 3rem;
  }

  .normalization-grid {
    display: grid;
    grid-template-areas:
      "lbl-top r1  r2  r3"
      ".       div div div"
      "lbl-bot n1  n2  n3";
    grid-template-columns: auto 1fr 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 8px;
    align-items: stretch;
  }

  /* Row labels */
  .row-label {
    writing-mode: vertical-lr;
    text-orientation: mixed;
    transform: rotate(180deg);
    font-family: monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 4px;
    border-radius: 4px 0 0 4px;
  }

  .row-label--top {
    grid-area: lbl-top;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.08);
    border-left: 2px solid rgba(239, 68, 68, 0.3);
  }

  .row-label--bottom {
    grid-area: lbl-bot;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.08);
    border-left: 2px solid rgba(34, 197, 94, 0.3);
  }

  .row-label-icon {
    font-size: 14px;
    transform: rotate(90deg);
  }

  /* Grid cells */
  .grid-cell {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .grid-cell:hover {
    border-color: rgba(255, 255, 255, 0.15);
    transform: scale(1.02);
    z-index: 10;
  }

  .grid-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }

  /* Cell badges */
  .cell-badge {
    position: absolute;
    font-family: monospace;
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    padding: 3px 8px;
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .cell-badge--raw {
    top: 6px;
    left: 6px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .cell-badge--norm {
    bottom: 6px;
    right: 6px;
    background: #e67e22;
  }

  /* Divider row */
  .grid-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  }

  .divider-label {
    font-family: monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e67e22;
    white-space: nowrap;
  }

  /* ────────────────────────────────────────────────────────────
     RESPONSIVE — Mobile stacks
     ──────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .normalization-grid {
      grid-template-areas:
        "r1  r2  r3"
        "div div div"
        "n1  n2  n3";
      grid-template-columns: 1fr 1fr 1fr;
      gap: 4px;
    }

    .row-label {
      display: none;
    }

    .cell-badge {
      font-size: 8px;
      padding: 2px 5px;
    }

    .header-title {
      font-size: 1rem;
    }

    .slider-container {
      border-radius: 4px;
    }
  }

  @media (max-width: 480px) {
    .normalization-grid {
      grid-template-areas:
        "r1  r2"
        "r3  r3"
        "div div"
        "n1  n2"
        "n3  n3";
      grid-template-columns: 1fr 1fr;
      gap: 4px;
    }
  }
</style>
