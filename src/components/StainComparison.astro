---
/**
 * StainComparison.astro
 * 
 * Interactive stain normalization showcase with:
 * 1. An img-comparison-slider for before/after single-patch comparison
 * 2. A 3x2 CSS grid demonstrating domain adaptation across different labs
 * 
 * Uses the img-comparison-slider web component (v8) from CDN.
 * Placeholder images in the grid can be swapped out for real GDC patches.
 */
---

<!-- img-comparison-slider web component -->
<script defer src="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/index.js" is:inline></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/styles.css" />

<section class="stain-comparison" id="stain-comparison">
  
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- SECTION 1: Interactive Before / After Slider               -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div class="slider-section">
    {/* TODO(owner): Confirm which reference image was used for slider comparison and verify exact FOV matching */}
    <div class="section-header">
      <h3 class="header-title">Interactive Stain Comparison</h3>
      <p class="header-subtitle">Drag the slider to compare raw scan vs. Reinhard LAB normalization output</p>
    </div>

    <div class="slider-container">
      <img-comparison-slider>
        <figure slot="first" class="slider-figure">
          <img src="/images/stain_bad.jpg" width="100%" alt="Raw Scan — Domain Shift Artifact" />
          <figcaption class="slider-label slider-label--left">
            <span class="label-dot label-dot--red"></span>
            RAW SCAN
          </figcaption>
        </figure>
        <figure slot="second" class="slider-figure">
          <img src="/images/stain_normalized.jpg" width="100%" alt="Normalized Output — Reinhard LAB" />
          <figcaption class="slider-label slider-label--right">
            <span class="label-dot label-dot--green"></span>
            NORMALIZED
          </figcaption>
        </figure>
      </img-comparison-slider>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- SECTION 2: Domain Adaptation Grid (3 Labs)                 -->
  <!-- ═══════════════════════════════════════════════════════════ -->
